{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nookive",
  "version": "0.1.0",
  "identifier": "com.nookive.search",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run bundle:prepare"
  },
  "app": {
    "windows": [
      {
        "title": "Nookive",
        "width": 780,
        "height": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "center": true,
        "shadow": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:8080 http://127.0.0.1:8081; worker-src 'self' asset: http://asset.localhost https://asset.localhost blob:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "$HOME/**",
          "$DOWNLOAD/**",
          "$PICTURE/**",
          "$DOCUMENT/**",
          "$DESKTOP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "resources": {
      "../bin": "bin",
      "../scripts/index-folder.mjs": "scripts/index-folder.mjs",
      "../node_modules/pdf-parse": "node_modules/pdf-parse",
      "../node_modules/@napi-rs/canvas": "node_modules/@napi-rs/canvas",
      "../node_modules/@napi-rs/canvas-darwin-arm64": "node_modules/@napi-rs/canvas-darwin-arm64"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
