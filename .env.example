# Nookive does not require an environment file for normal development or use.
#
# The optional variables below are process settings for local development only;
# they are not secrets and should never contain credentials.
# NOOKIVE_PORT=8080
# NOOKIVE_CPU_ONLY=1
# NOOKIVE_ALLOW_CPU_FALLBACK=1
# NOOKIVE_CTX_SIZE=2048
# NOOKIVE_BATCH_SIZE=1024
# NOOKIVE_UBATCH_SIZE=1024
# NOOKIVE_PARALLEL=1
# NOOKIVE_ASR_PORT=8081
